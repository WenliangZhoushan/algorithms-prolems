{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run current file with input",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "if exist input.txt (python \"${file}\" < input.txt) else if exist input (python \"${file}\" < input) else python \"${file}\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "silent",
                "echo": false,
                "focus": false,
                "panel": "dedicated",
                "clear": true,
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
